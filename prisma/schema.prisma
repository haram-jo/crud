generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output        = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  todos        Todo[]
  schedules    Schedule[]
}

enum TodoStatus {
  TODO
  DOING
  DONE
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
}

model Todo {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  memo      String?
  dueDt     DateTime?
  priority  TodoPriority @default(MEDIUM)
  status    TodoStatus   @default(TODO)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId, status])
  @@index([userId, dueDt])
}

model Schedule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  memo      String?
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startAt])
}
