# PostgreSQL connection string (Vercel Postgres / Neon / local docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crud?schema=public"

# 32+ bytes random secret for JWT signing (HS256).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET="change-me-to-a-long-random-secret"

# Public app name displayed in header
NEXT_PUBLIC_APP_NAME="CRUD"
